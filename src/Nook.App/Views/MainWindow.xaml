<Window x:Class="Nook.App.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Nook.App.Controls" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Nook" Width="1100" Height="780" MinWidth="900" MinHeight="640" WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize" Background="#01000000" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource BodyFont}" FontSize="14" Icon="/Nook;component/Assets/nook.ico">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="50" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="42"/><Setter Property="Height" Value="30"/><Setter Property="Margin" Value="2,0"/><Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="ToolTipService.InitialShowDelay" Value="500"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="CaptionChrome" Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CaptionChrome" Property="Background" Value="{DynamicResource SoftAccentBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="CaptionChrome" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CaptionChrome" Property="Background" Value="{DynamicResource SoftAccentBrush}"/><Setter TargetName="CaptionChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="MainFrame" Margin="6" CornerRadius="14" Background="{DynamicResource PageBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" SizeChanged="Frame_SizeChanged">
    <Border.Effect><DropShadowEffect Color="Black" Opacity="0.14" BlurRadius="8" ShadowDepth="2"/></Border.Effect>
    <Grid x:Name="MainShell" SizeChanged="Frame_SizeChanged"><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="14,0,6,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="Nook" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="최소화" AutomationProperties.Name="최소화"><controls:FluentIcon Glyph="subtract" Width="16" Height="16" Foreground="{DynamicResource TextBrush}"/></Button>
          <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="최대화" AutomationProperties.Name="최대화"><controls:FluentIcon x:Name="MaximizeIcon" Glyph="square" Width="16" Height="16" Foreground="{DynamicResource TextBrush}"/></Button>
          <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Click="Close_Click" ToolTip="닫기" AutomationProperties.Name="닫기"><controls:FluentIcon Glyph="dismiss" Width="16" Height="16" Foreground="{DynamicResource TextBrush}"/></Button>
        </StackPanel>
      </Grid>
  <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="16,28,16,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="12,0,0,36"><TextBlock Text="nook." FontFamily="{StaticResource NumberFont}" FontSize="38" FontWeight="ExtraBold"/></StackPanel>
        <StackPanel Grid.Row="1">
          <Button x:Name="LibraryNav" Style="{StaticResource NavButton}" Click="Library_Click" TabIndex="100" AutomationProperties.Name="위젯 라이브러리"><StackPanel Orientation="Horizontal"><controls:FluentIcon Glyph="apps" Foreground="{DynamicResource TextBrush}" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="위젯 라이브러리"/></StackPanel></Button>
          <Button x:Name="ManageNav" Style="{StaticResource NavButton}" Click="Manage_Click" TabIndex="101" AutomationProperties.Name="내 위젯"><StackPanel Orientation="Horizontal"><controls:FluentIcon Glyph="board" Foreground="{DynamicResource TextBrush}" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="내 위젯"/></StackPanel></Button>
          <Button x:Name="PresetsNav" Style="{StaticResource NavButton}" Click="Presets_Click" TabIndex="102" AutomationProperties.Name="프리셋"><StackPanel Orientation="Horizontal"><controls:FluentIcon Glyph="square_multiple" Foreground="{DynamicResource TextBrush}" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="프리셋"/></StackPanel></Button>
          <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Click="Settings_Click" TabIndex="103" AutomationProperties.Name="설정"><StackPanel Orientation="Horizontal"><controls:FluentIcon Glyph="settings" Foreground="{DynamicResource TextBrush}" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="설정"/></StackPanel></Button>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="12,0,0,0"><TextBlock Text="Nook 0.15.0" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="32,28,32,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock x:Name="PageTitle" Text="위젯 라이브러리" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Visibility="Collapsed"/></StackPanel>
      </Grid>
      <ScrollViewer x:Name="PageScroll" Grid.Row="1" Style="{StaticResource SoftScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
        <StackPanel>
          <StackPanel x:Name="LibraryPage">
            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Grid Margin="0,0,16,0"><TextBox x:Name="LibrarySearch" Style="{StaticResource SearchInput}" TextChanged="LibrarySearch_Changed" AutomationProperties.Name="위젯 검색" ToolTip="위젯 검색" Padding="12" VerticalContentAlignment="Center"/><TextBlock Text="위젯 검색" Foreground="{DynamicResource MutedBrush}" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=LibrarySearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
            </Grid>
            <WrapPanel x:Name="LibraryCategoryHost" Margin="0,0,0,12"/>
            <TextBlock x:Name="LibraryEmpty" Text="검색 결과 없음" Style="{StaticResource MutedText}" Visibility="Collapsed" Margin="0,24"/>
            <UniformGrid x:Name="FeatureLibraryHost" Columns="3" Margin="0,0,-12,0" SizeChanged="LibraryHost_SizeChanged"/>
          </StackPanel>
          <StackPanel x:Name="ManagePage" Visibility="Collapsed">
            <DockPanel Margin="0,0,0,16"><Button x:Name="CreateGroupButton" DockPanel.Dock="Right" Click="CreateGroup_Click" Content="그룹 추가" Margin="8,0,0,0"/><ComboBox x:Name="ManageFilter" Width="150" HorizontalAlignment="Left" SelectionChanged="ManageFilter_Changed" AutomationProperties.Name="내 위젯 보기"/><TextBlock Text="{Binding WidgetCount}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="16,0,0,0"/></DockPanel>
            <WrapPanel x:Name="ManageTagsHost" Margin="0,0,0,12" Visibility="Collapsed"/>
            <TextBlock x:Name="GroupEmpty" Text="등록된 그룹이 없습니다." Style="{StaticResource MutedText}" FontSize="12" Visibility="Collapsed"/><StackPanel x:Name="GroupsHost" Visibility="Collapsed"/>
            <StackPanel x:Name="WidgetsHost"/>
            <TextBlock x:Name="EmptyWidgets" Text="아직 위젯이 없습니다. 라이브러리에서 첫 위젯을 추가하세요." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
          </StackPanel>
          <StackPanel x:Name="PresetsPage" Visibility="Collapsed">
            <StackPanel x:Name="PresetHost"/>
          </StackPanel>
          <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
            <TextBlock Text="배치" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,24"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,24,0"><TextBlock Text="Magnetic Mode" FontWeight="Medium"/></StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding MagneticModeStateLabel}" Style="{StaticResource MutedText}" Width="34" VerticalAlignment="Center" FontSize="12"/><ToggleButton x:Name="MagneticModeToggle" Style="{StaticResource SwitchToggle}" IsChecked="{Binding MagneticMode, Mode=TwoWay}" AutomationProperties.Name="Magnetic Mode" ToolTip="Magnetic Mode ON/OFF"/></StackPanel>
            </Grid></Border>
            <TextBlock Text="기본 외형과 앱 동작" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
            <Border Style="{StaticResource Card}"><StackPanel x:Name="GlobalSettingsHost"/></Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,12,0,0">
        <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Status}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
        <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" FontSize="11"/>
      </Border>
    </Grid>
  </Grid></Grid></Border>
</Window>

